<!DOCTYPE HTML>
<html lang="<%= config.language %>">
<%- partial('_partial/head') %>


<body<% if (page.book) { %> class="book-reading-page"<% } %>>
    <!-- 网站全局深色模式设置开始 -->
    <script>
        if (localStorage.getItem('dark') === '1') {
        document.body.classList.add('dark');
        }
        //  else if (new Date().getHours() >= 22 || new Date().getHours() < 7) {
        // document.body.classList.add('dark');
        // } 
        else if (matchMedia('(prefers-color-scheme: dark)').matches) {
        document.body.classList.add('dark');
        }
    </script>
    <button type="button" onclick="switchNightMode()" id="sma" aria-label="切换深色模式">
        <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 13.1A8.7 8.7 0 0 1 10.9 3.5 8.7 8.7 0 1 0 20.5 13.1Z"/></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <!-- 网站全局深色模式设置结束 -->



    <%- partial('_partial/header') %>
    <%- body %>

    <%- partial('_partial/footer') %>

    <%- partial('_partial/search') %>
    <%- partial('_partial/back-top') %>

    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.materialize) %>"></script>
    <% if (!page.book) { %><script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.masonry) %>"></script><% } %>
    <% if (!page.book) { %><script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.aos) %>"></script><% } %>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.scrollProgress) %>"></script>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.lightgallery) %>"></script>
    <script src="<%- theme.jsDelivr.url %><%- url_for('/js/matery.js') %>"></script>
    
    <%- partial('_partial/baidu-push') %>
    <% if (theme.busuanziStatistics && theme.busuanziStatistics.enable) { %>
    <script async src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.busuanzi) %>"></script>
    <% } %>

    <% if (theme.instantpage.enable) { %>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.instantpage) %>" type="module"></script>
    <% } %>


 
    <% if (!page.book && !is_post()) { %><script type="text/javascript" src="/js/click_show_text.js"></script><% } %>









    <script src="<%- url_for('/js/site-navigation.js') %>" defer></script>
</body>
</html>
