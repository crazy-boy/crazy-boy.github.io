<link rel="stylesheet" href="<%- url_for('/css/post-toc.css') %>">
<% const showArticleToc = !(page.tags && page.tags.toArray().some(tag => tag.name === '随笔')); %>
<div class="post-reading-layout <%= showArticleToc ? '' : 'toc-collapsed' %>">
  <div id="main-content"><%- partial('_partial/post-detail.ejs') %></div>
  <% if (showArticleToc) { %>
  <aside id="toc-aside" aria-label="文章目录">
    <div class="toc-widget"><div class="toc-title"><i class="far fa-list-alt" aria-hidden="true"></i> 目录</div><div id="toc-content" data-headings="<%= theme.toc.heading %>"></div></div>
  </aside>
  <% } %>
</div>
<% if (showArticleToc) { %>
<% if (theme.toc.showToggleBtn) { %>
<div id="floating-toc-btn" class="hide-on-med-and-down"><button type="button" class="btn-floating bg-color" aria-label="收起文章目录" aria-controls="toc-aside" aria-expanded="true"><i class="fas fa-list-ul" aria-hidden="true"></i></button></div>
<% } %>
<script src="<%- url_for('/js/article-toc.js') %>" defer></script>
<% } %>
