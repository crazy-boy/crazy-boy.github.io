<link rel="stylesheet" href="<%- url_for('/css/crypto-book.css') %>">
<section class="authored-books shelf-authored" aria-label="我的作品">
<div id="book"><div class="page"><ul class="content">
<% (site.data.book_catalog || []).forEach(book => { %>
<li><div class="info">
<a class="book-container" href="<%- url_for(book.url) %>" aria-label="<%= book.title %>"><div class="book"><div class="book-cover-face"><small><%= book.label %></small><strong><%= book.shortTitle %></strong><span><%= book.subtitle %></span></div></div></a>
<div><h3><a href="<%- url_for(book.url) %>"><%= book.title %></a></h3><p>作者：<%= book.author %></p><p>在线阅读 · <%= book.entries.filter(e => e.kind === 'chapter').length %> 章 · <%= book.entries.length - 1 %> 篇</p>
<div class="book-reading-actions"><a class="authored-book-link" href="<%- url_for(book.url) %>">查看目录 →</a><a class="book-resume" data-book-resume="<%= book.id %>" hidden>继续阅读 →</a><small data-book-progress-label></small></div>
</div></div><p class="description"><%= book.description %></p></li>
<% }); %>
</ul><p class="book-progress-note">阅读进度仅保存在当前浏览器，清除浏览器数据后会重置。</p></div></div>
</section>
<%- partial('_partial/book-progress-data', { books: site.data.book_catalog || [] }) %>
