<% const related = related_posts(page); if (related.length) { %>
<section class="related-reading" aria-labelledby="related-reading-title"><h2 id="related-reading-title">继续阅读</h2><p>与本文主题相关的文章。</p><ul><% related.forEach(post => { %><li><a href="<%- url_for(post.path) %>"><%= post.title %></a><p><%= site_summary(post, 85) %></p></li><% }); %></ul><a href="<%- url_for('/topics/') %>">按专题阅读 →</a></section>
<% } %>
