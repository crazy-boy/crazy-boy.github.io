<% if (is_post() || page.layout === 'contact') { %>
<link rel="stylesheet" href="<%- url_for('/css/comments.css') %>">
<section class="card valine-card" id="vcomments-top" aria-label="留言">
  <div class="card-content"><h2 class="comments-title">留言</h2><p class="comments-hint">想法、疑问或勘误，都可以写在这里。留言会公开显示。</p><div id="vcomments"></div></div>
</section>
<script src="<%- url_for('/libs/valine/av-min.js') %>"></script>
<script src="<%- url_for(theme.libs.js.valine) %>"></script>
<script>
  new Valine({
    el: '#vcomments',
    appId: <%- JSON.stringify(theme.valine.appId) %>,
    appKey: <%- JSON.stringify(theme.valine.appKey) %>,
    path: location.pathname,
    meta: [], requiredFields: [], enableQQ: false,
    recordIP: false, visitor: false, notify: false,
    verify: <%- JSON.stringify(!!theme.valine.verify) %>,
    avatar: '', pageSize: 10, lang: 'zh-cn',
    placeholder: '写下你的留言…'
  });
</script>
<% } %>
