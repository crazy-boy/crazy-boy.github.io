<div id="searchModal" class="modal">
  <div class="modal-content">
    <div class="search-header">
      <label for="searchInput">搜索博文与书籍</label>
      <input type="search" id="searchInput" name="s" placeholder="输入标题或正文关键词" class="search-input" autocomplete="off">
    </div>
    <div class="search-filters" role="group" aria-label="搜索范围">
      <button type="button" class="site-button" data-search-scope="all" aria-pressed="true">全部</button>
      <button type="button" class="site-button" data-search-scope="post" aria-pressed="false">博文</button>
      <button type="button" class="site-button" data-search-scope="book" aria-pressed="false">书籍</button>
    </div>
    <p id="searchStatus" class="search-status" role="status">输入关键词开始搜索。</p>
    <div id="searchResult"></div>
  </div>
</div>
<script type="application/json" id="searchBooks"><%- JSON.stringify((site.data.book_catalog || []).map(book => ({title: book.title, url: url_for(book.url)}))).replace(/</g, '\u003c') %></script>
<script src="<%- url_for('/js/search.js') %>" defer data-search-index="<%- url_for('search.xml') %>" data-post-prefix="<%- url_for('/posts/') %>"></script>
