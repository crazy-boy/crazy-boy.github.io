<% if (is_home() && page.current === 1) { %>
<%- partial('_partial/index-cover') %>
<% } else { %>
<%- partial('_partial/bg-cover') %>
<% } %>

<style>
  /* 主页背景图 */
  .bg-cover {
    background-image: url("/medias/banner/001.JPG") !important;
  }
</style>

<style>
  @media only screen and (max-width: 601px) {
  }

  .hurens {
    color: #926fec;
    font-size: 1.08rem;
  }

  body.dark .hurens {
    color: #926fec !important;
  }
</style>

<main class="content">
  <% if (page.current === 1
            && ((theme.dream.enable || theme.music.enable)
                    || theme.video.enable || theme.recommend.enable)) { %>
  <div id="indexCard" class="index-card">
    <div class="container ">
      <% if (theme.dream.enable) { %>
      <section class="card home-quote-card"><%- partial('_widget/dream') %></section>
      <% } %>
      <% if (theme.video.enable) { %><section class="card"><%- partial('_widget/video') %></section><% } %>
      <section class="card home-intro"><div class="home-intro-body">
        <p class="home-intro-lead">把经历写成文字，让思考留下回声。</p>
        <p>这里记录技术实践、问题复盘，以及学习过程中逐渐想明白的事。</p>
        <p>较完整的主题整理在<a href="/books/">我的作品</a>，日常的小程序放在<a href="/tools/">工具下载</a>。</p>
        <p>代码与项目收录在 <a href="https://github.com/crazy-boy" target="_blank" rel="noopener">GitHub</a>，欢迎交流。</p>
        <div class="home-contact"><a href="/contact/">留言板 ↗</a><a href="mailto:pengbing945@protonmail.com">pengbing945@protonmail.com</a><span>QQ · 1489249823</span></div>
      </div></section>
    </div>
  </div>

  <% }%>

  <%
    var hashCode = function (str) {
        if (!str && str.length === 0) {
            return 0;
        }

        var hash = 0;
        for (var i = 0, len = str.length; i < len; i++) {
            hash = ((hash << 5) - hash) + str.charCodeAt(i);
            hash |= 0;
        }
        return hash;
    };
    %>

  <!-- 所有文章卡片开始 -->
  <article id="articles" class="container articles">
    <div class="row article-row">
      <% page.posts.forEach(post => { %>
      <div class="article col s12 m6 l4">
        <div class="card">
          <!-- 推荐文章置顶模块效果开始 -->
          <% if (post.top) { %>
          <div class="placetop">推荐文章</div>
          <style>
            .placetop {
              z-index: 99;
              position: absolute;
              top: 0;
              left: 0;
              width: 80px;
              height: 30px;
              line-height: 30px;
              border-bottom-right-radius: 8px;
              background-color: #039be5;
              text-align: center;
              font-size: 15px;
              color: #fff;
              font-weight: 400 !important;
              opacity: 0.95;
            }

            body.dark .placetop {
              opacity: 0.75;
            }
          </style>
          <% } %>
          <!-- 推荐文章置顶模块效果结束 -->
          <a href="<%- url_for(post.path) %>">
            <div class="card-image">

              <% if (post.img) { %>
              <img src="<%- url_for(post.img) %>" class="responsive-img" alt="<%= post.title %>">
              <% } else { %>
              <%
                                var featureimg = '/medias/featureimages/0.jpg';
                                var featureImages = theme.featureImages;
                                if (!featureImages || featureImages.length == 0) {
                                    return featureimg;
                                }
                                featureimg = featureImages[Math.abs(hashCode(post.title) % featureImages.length)]
                            %>
              <img src="<%- theme.jsDelivr.url %><%- url_for(featureimg) %>" class="responsive-img"
                alt="<%= post.title %>">
              <% } %>
              <span class="card-title">
                <%= post.title %>
                <!-- 文章卡片hover线条效果 -->
                <span class="titlesline">
                  <style>
                    .titlesline {
                      width: 0px;
                      height: 4px;
                      background-color: #fadca6;
                      border-radius: 2px;
                      position: absolute;
                      top: 10px;
                      left: 24px;
                    }

                    body.dark .titlesline {
                      filter: brightness(.7);
                    }

                    article .card .titlesline {
                      transition: all 0.36s ease;
                    }

                    article .card-image:hover .titlesline {
                      width: 36px;
                    }
                  </style>
                </span>
              </span>
            </div>
          </a>

          <div class="card-content article-content">
            <div class="summary block-with-text">
              <% if (post.summary && post.summary.length > 0) { %>
              <%- post.summary %>
              <% } else { %>
              <%- strip_html(post.content).substring(0, 120) %>
              <% } %>
            </div>
            <div class="publish-info">
              <span class="publish-date">
                <i class="far fa-clock fa-fw icon-date"></i><%= date(post.date, config.date_format) %>
              </span>
              <span class="publish-author">
                <% if (post.categories && post.categories.length > 0) { %>
                <i class="fas fa-bookmark fa-fw icon-category"></i>
                <% post.categories.forEach(category => { %>
                <a href="<%- url_for(category.path) %>" class="post-category">
                  <%- category.name %>
                </a>
                <% }); %>
                <% } else if (post.author && post.author.length > 0) { %>
                <i class="fas fa-user fa-fw"></i>
                <%- post.author %>
                <% } else { %>
                <i class="fas fa-user fa-fw"></i>
                <%- config.author %>
                <% } %>
              </span>
            </div>
          </div>

          <% if(post.tags && post.tags.length > 0) { %>
          <div class="card-action article-tags">
            <% post.tags.forEach(tag => { %>
            <a href="<%- url_for(tag.path) %>">
              <span class="chip bg-color"><%= tag.name %></span>
            </a>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </article>
  <!-- 所有文章卡片结束 -->
</main>

<% if (page.total > 1) { %>
<%- partial('_partial/paging') %>
<% } %>
